{
  "servers": [
    {
      "name": "echo",
      "command": "node",
      "args": ["scripts/mcp-echo-server.mjs"],
      "disabled": false,
      "tools": [
        {
          "name": "echo",
          "description": "Echo back arguments (live stdio example)",
          "parameters": {
            "type": "object",
            "properties": {
              "message": { "type": "string" }
            },
            "required": ["message"]
          }
        }
      ]
    },
    {
      "name": "filesystem",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"],
      "disabled": true,
      "tools": [
        {
          "name": "list_files",
          "description": "List files (example static advertisement)",
          "parameters": {
            "type": "object",
            "properties": {
              "path": { "type": "string" }
            },
            "required": ["path"]
          }
        }
      ]
    }
  ]
}
